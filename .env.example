# MongoDB database used by Better Auth
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Auth secret — generate with: npx better-auth secret
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public URL of this Next.js app
BETTER_AUTH_URL=http://localhost:3000

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: imgbb API key for book cover uploads
NEXT_PUBLIC_IMGBB_KEY=

# Optional: Google OAuth (only needed if Google sign-in is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
